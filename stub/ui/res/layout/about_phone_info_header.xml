<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/device_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/about_tile_background"
            android:clipToOutline="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:outlineProvider="background"
            android:padding="18dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-24dp"
                android:layout_marginBottom="-24dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_about_device"
                android:tint="@color/about_tile_accent" />

            <TextView
                android:id="@+id/device_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/derpfest_device_title"
                android:textAppearance="@style/TextAppearance.AboutTileLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/device_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:breakStrategy="balanced"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.AboutTileValue" />

                <TextView
                    android:id="@+id/device_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AboutTileLabel" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/about_tile_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/about_tile_background"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/memory_storage_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/derpfest_memory_storage_title"
                    android:textAppearance="@style/TextAppearance.AboutTileLabel" />

                <TextView
                    android:id="@+id/memory_storage_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AboutTileValue" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/about_tile_gap"
                android:layout_weight="1"
                android:background="@drawable/about_tile_background"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/battery_size_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/derpfest_battery_size_title"
                    android:textAppearance="@style/TextAppearance.AboutTileLabel" />

                <TextView
                    android:id="@+id/battery_size_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AboutTileValue" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="@dimen/about_tile_gap"
        android:background="@drawable/about_tile_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/screen_res_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/derpfest_screen_res_title"
                android:textAppearance="@style/TextAppearance.AboutTileLabel" />

            <TextView
                android:id="@+id/screen_res_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AboutTileValue"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/screen_class"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/about_tile_chip"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/about_tile_accent"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
